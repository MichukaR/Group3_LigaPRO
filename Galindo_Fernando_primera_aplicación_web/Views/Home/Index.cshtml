@{
    ViewData["Title"] = "Inicio - LigaPro Ecuador";
}

<div class="jumbotron bg-primary text-white text-center mb-4 rounded">
    <h1 class="display-4">¡Vive la Pasión de la LigaPro Ecuador!</h1>
    <p class="lead">Tu portal para toda la información del fútbol profesional ecuatoriano.</p>
    <a class="btn btn-light btn-lg" asp-controller="Equipo" asp-action="List" role="button">Ver la Lista de Equipos</a>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                Próximos Partidos Destacados
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">LDU Quito vs. Barcelona SC - Sábado, 20 de Abril - 18:00</li>
                <li class="list-group-item">Independiente del Valle vs. Emelec - Domingo, 21 de Abril - 15:30</li>
                <li class="list-group-item">Aucas vs. Universidad Católica - Domingo, 21 de Abril - 19:00</li>
            </ul>
            <div class="card-footer">
                <a href="#">Ver Calendario Completo</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                Tabla de Posiciones (Top 5)
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">1. LDU Quito - 25 pts</li>
                <li class="list-group-item">2. Independiente del Valle - 23 pts</li>
                <li class="list-group-item">3. Barcelona SC - 22 pts</li>
                <li class="list-group-item">4. Aucas - 20 pts</li>
                <li class="list-group-item">5. Emelec - 19 pts</li>
            </ul>
            <div class="card-footer">
                <a href="#">Ver Tabla Completa</a>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                Últimas Noticias
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><a href="#">Jugador de LDU nombrado el mejor de la semana.</a></li>
                <li class="list-group-item"><a href="#">Barcelona SC anuncia nuevo fichaje para la próxima temporada.</a></li>
                <li class="list-group-item"><a href="#">Polémica arbitral en el partido entre Independiente y Emelec.</a></li>
            </ul>
            <div class="card-footer">
                <a href="#">Ver Todas las Noticias</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                Goleadores (Top 3)
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">1. Ismael Díaz (Universidad Católica) - 10 goles</li>
                <li class="list-group-item">2. Francisco Fydriszewski (Aucas) - 9 goles</li>
                <li class="list-group-item">3. Jhon Jairo Cifuente (Aucas) - 8 goles</li>
            </ul>
            <div class="card-footer">
                <a href="#">Ver Tabla de Goleadores Completa</a>
            </div>
        </div>
    </div>
</div>

<div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
    <ol class="carousel-indicators">
        <li data-target="#carouselExampleControls" data-slide-to="0" class="active"></li>
        <li data-target="#carouselExampleControls" data-slide-to="1"></li>
        <li data-target="#carouselExampleControls" data-slide-to="2"></li>
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="~/Imagenes/img1.jpg" alt="Imagen LigaPro 1">
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="~/Imagenes/img2.jpg" alt="Imagen Estadio Ecuador">
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="~/Imagenes/img3.jpg" alt="Imagen Balón LigaPro">
        </div>
    </div>
    <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Anterior</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Siguiente</span>
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#carouselExampleControls').carousel();
        });
    </script>
}